# LaTeX build byproducts
/docs/*.aux
/docs/*.log
/docs/*.out
/docs/*.fls
/docs/*.fdb_latexmk
/docs/*.synctex.gz
/docs/paper/build/**
!/docs/paper/build/.gitkeep

# Rust/build outputs
/target/

# Local environment files
.env
.env.*
!.env.example

# Private workspace context - not part of the public artifact
/AGENTS.md
/docs/README.md
/docs/plans/**
/docs/rebuttal/**
/docs/reviews/**
/docs/roadmap/**
/docs/engineering/**
/docs/*_PLAN.md
/docs/experiment_guide.md
/docs/journal_experiment_plan.md
/docs/remaining_advanced_work_plan.md
/docs/rust_file_level_rpd_plan.md
/docs/rust_implementation_plan.md
/docs/PUBLISHABILITY_ASSESSMENT.md
/docs/paper_artifact_alignment_review.md
/reviews/**

# Real multi-host benchmark target list (contains real IPs/ssh targets).
# The tracked template is config/hosts.txt.example.
/config/hosts.txt
/config/hosts_n12.txt
/config/hosts_*.txt

# SSH private/public keys for the benchmark VMs — MUST NEVER be committed.
/config/secret/
/config/secret/**

# Local tool scratch files
/.codex/
/.claude/
/.cursor/
/.hermes/
/.mcp_agentmemory/
/.graphify/
/graphify/
# graphify transient cache / interpreter helpers (NOT the committed graph outputs).
# graphify-out/ (GRAPH_REPORT.md, graph.json, graph.html) IS tracked as shared state.
/.graphify_*
/graphify-out/cache/
/graphify-out/.graphify_python
/graphify-out/.needs_update
/**/.DS_Store

# TLC raw state dumps (large, regenerable); keep only the tiny committed/ projections
formal/states/*.txt
formal/states/*.dump
formal/*.dump
